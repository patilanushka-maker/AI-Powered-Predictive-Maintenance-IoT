# ==============================================================================
# Environment Configuration Template (.env.example)
# AI-Powered Predictive Maintenance for IoT Devices
#
# INSTRUCTIONS:
# Copy this file to '.env' for local configuration overrides:
#   copy .env.example .env
#
# NOTE: The '.env' file is strictly excluded by .gitignore and must never be
# committed to version control.
# ==============================================================================

# Application & Streamlit Server Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ADDRESS=localhost

# Logging & Execution Configuration
LOG_LEVEL=INFO
APP_ENV=development
